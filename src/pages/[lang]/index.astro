---
import Base from "../../layouts/Base.astro";
import MarketButtons from "../../components/MarketButtons.astro";
import { t } from "../../data/content";
import { href, staticLangPaths, type Locale } from "../../data/i18n";
import { formatPrice } from "../../data/format";
import { HONEY_TYPES, lowestPrice, PRODUCTS } from "../../data/products";

export function getStaticPaths() {
  return staticLangPaths();
}

const lang = Astro.params.lang as Locale;
const c = t(lang);

// Zig-zag route positions (% of the route box) for the four apiaries.
const PIN_POS = [
  [20, 14],
  [74, 32],
  [28, 60],
  [76, 86],
];

const sceneData = {
  products: PRODUCTS.map((p) => ({
    color: p.color,
    label: p.label,
    name: p.copy[lang].name,
    type: HONEY_TYPES[p.type][lang],
  })),
  lid: c.lid.items.map((i) => ({ mark: i.mark, caption: i.title })),
  claims: c.claims.items.map((i) => i.banner),
};
---

<Base lang={lang} scene="home" sceneData={sceneData} lightHeader>
  <!-- Hero -->
  <section class="hero" id="top">
    <div class="hero__bg" aria-hidden="true">
      <span class="haze haze--amber"></span>
      <span class="haze haze--rose"></span>
      <span class="haze haze--gold"></span>
    </div>
    <div class="hero__stage" data-anchor="hero-stage"></div>

    <div class="hero__copy">
      <p class="eyebrow" data-from="left" style="--i:0">{c.hero.eyebrow}</p>
      <h1 class="display h1" data-from="left" style="--i:1">{c.hero.titleA}<br /><em>{c.hero.titleB}</em></h1>
      <p class="lede" data-from="left" style="--i:2">{c.hero.lede}</p>
      <div class="cta" data-from="left" style="--i:3">
        <a class="btn btn--honey" href={href(lang, "/honeys")}>{c.hero.primary}</a>
        <a class="link-arrow" href={href(lang, "/about")}>{c.hero.secondary} <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <aside class="hero__proof">
      <div class="trust-line" data-from="right" style="--i:0.8">
        <div class="avatars" aria-hidden="true">
          {
            ["#c9873a", "#7a5a3a", "#a46b4f", "#5d4a36"].map((a) => (
              <span style={`--a:${a}`}>
                <svg viewBox="0 0 24 24"><path d="M12 2l8.66 5v10L12 22l-8.66-5V7z" fill="#fff4e2" /></svg>
              </span>
            ))
          }
        </div>
        <p>{c.hero.trust}</p>
      </div>
      <div class="folders">
        {
          c.hero.cards.map((card, i) => (
            <article class="folder" data-from="right" style={`--i:${1.8 + i}`}>
              <span class="folder__tab">{card.tab}</span>
              <figure class="folder__media">
                <img alt="" data-shot={i === 0 ? "head" : "wing"} />
                <figcaption>{card.caption}</figcaption>
              </figure>
              <p class="folder__stat">{card.stat}</p>
              <p class="folder__dots" aria-hidden="true">
                {Array.from({ length: 3 - i }, () => <i />)}
              </p>
            </article>
          ))
        }
      </div>
    </aside>
    <p class="scroll-cue" aria-hidden="true">{c.hero.scroll}</p>
  </section>

  <!-- Read the lid -->
  <section class="scene scene--lid lid" data-scene-part="lid" aria-labelledby="lid-title">
    <div class="scene__sticky">
      <div class="wrap lid__grid">
        <div>
          <div class="section-head">
            <p class="eyebrow">{c.lid.eyebrow}</p>
            <h2 class="display h2" id="lid-title">{c.lid.heading}</h2>
          </div>
          <ol class="lid__items">
            {
              c.lid.items.map((item, i) => (
                <li class:list={["lid__item", { "is-active": i === 0 }]}>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="lid__stage" data-anchor="lid-stage"></div>
      </div>
    </div>
  </section>

  <!-- Varieties -->
  <section class="scene scene--varieties" data-scene-part="varieties" aria-labelledby="var-title">
    <div class="scene__sticky">
      <div class="wrap var__grid">
        <div>
          <div class="section-head" style="margin-bottom: 36px">
            <p class="eyebrow">{c.varieties.eyebrow}</p>
            <h2 class="display h2" id="var-title">{c.varieties.heading}</h2>
          </div>
          <div class="var__panels">
            {
              PRODUCTS.map((p, i) => {
                const pc = p.copy[lang];
                return (
                  <article class:list={["variety", { "is-active": i === 0 }]} data-index={i}>
                    <span class="variety__type" style={`--flavor:${p.label}`}>{HONEY_TYPES[p.type][lang]}</span>
                    <h3 class="display h3">{pc.name}</h3>
                    <dl>
                      <dt>{c.product.floralSource}</dt>
                      <dd>{pc.floralSource}</dd>
                      <dt>{c.product.harvestSeason}</dt>
                      <dd>{pc.harvestSeason}</dd>
                      <dt>{c.product.tastingNotes}</dt>
                      <dd>{pc.tastingNotes}</dd>
                    </dl>
                    <p class="variety__price">
                      {c.common.from} <strong>{formatPrice(lowestPrice(p))}</strong>
                    </p>
                    <a class="btn btn--ghost" href={href(lang, `/honeys/${p.slug}`)}>
                      {c.varieties.view} <span aria-hidden="true">→</span>
                    </a>
                  </article>
                );
              })
            }
          </div>
          <div class="var__dots" role="tablist">
            {PRODUCTS.map((p, i) => <button type="button" class:list={{ "is-active": i === 0 }} data-index={i} aria-label={p.copy[lang].name} />)}
          </div>
        </div>
        <div class="var__stage-wrap">
          <div class="var__stage" data-anchor="var-stage"></div>
          <!-- Phones: big flavour name under the jar -->
          <p class="var__flavor" aria-hidden="true">
            {PRODUCTS.map((p, i) => <span class:list={{ "is-active": i === 0 }} style={`--flavor:${p.label}`}>{HONEY_TYPES[p.type][lang]}</span>)}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why raw matters -->
  <section class="section" data-scene-part="claims" aria-labelledby="claims-title">
    <span class="glow" style="width: 40vw; height: 30vw; left: -10vw; top: 10%; background: #c9821c"></span>
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">{c.claims.eyebrow}</p>
        <h2 class="display h2" id="claims-title">{c.claims.heading}</h2>
      </div>
      <div class="claims">
        {
          c.claims.items.map((item, i) => (
            <article class="claim glass reveal" data-claim={i} style={`transition-delay:${i * 0.1}s`}>
              <p class="claim__num">0{i + 1}</p>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Sourcing -->
  <section class="section" id="sourcing" data-scene-part="route" aria-labelledby="route-title">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">{c.sourcing.eyebrow}</p>
        <h2 class="display h2" id="route-title">{c.sourcing.heading}</h2>
        <p class="lede">{c.sourcing.body}</p>
      </div>
      <div class="route" data-route>
        <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <path
            vector-effect="non-scaling-stroke"
            d={`M ${PIN_POS[0][0]} ${PIN_POS[0][1]} C 50 6, 70 14, ${PIN_POS[1][0]} ${PIN_POS[1][1]} S 30 44, ${PIN_POS[2][0]} ${PIN_POS[2][1]} S 70 74, ${PIN_POS[3][0]} ${PIN_POS[3][1]}`}
          ></path>
        </svg>
        {
          c.sourcing.pins.map((pin, i) => (
            <article class="pin glass" data-pin={i} style={`left:${PIN_POS[i][0]}%; top:${PIN_POS[i][1]}%`}>
              <p class="pin__region">{pin.region}</p>
              <h3>{pin.name}</h3>
              <p>
                {pin.honey} · {c.sourcing.harvest} {pin.harvest}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Story + trust -->
  <section class="section" data-scene-part="story" aria-labelledby="story-title">
    <span class="glow" style="width: 36vw; height: 30vw; right: -8vw; top: 0; background: #f0b43c"></span>
    <div class="wrap story">
      <div class="reveal">
        <p class="eyebrow">{c.story.eyebrow}</p>
        <h2 class="display h2" id="story-title" style="margin-top: 16px">{c.story.heading}</h2>
        <p class="lede" style="margin-top: 20px">{c.story.body}</p>
        <a class="btn btn--ghost" style="margin-top: 28px" href={href(lang, "/about")}>{c.story.cta} <span aria-hidden="true">→</span></a>
      </div>
      <div class="trust">
        {
          c.trust.map((item, i) => (
            <div class="trust__item glass reveal" style={`transition-delay:${i * 0.08}s`}>
              <p class="trust__value" data-count={item.value}>{item.value}</p>
              <p class="trust__label">{item.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Finale -->
  <section class="wrap finale" data-scene-part="finale" aria-labelledby="finale-title">
    <div class="reveal">
      <h2 class="display h2" id="finale-title">{c.finale.heading}</h2>
      <p class="lede" style="margin-top: 20px">{c.finale.body}</p>
      <MarketButtons lang={lang} note />
      <a class="link-arrow" style="display: inline-block; margin-top: 22px" href={href(lang, "/honeys")}>{c.varieties.all} →</a>
    </div>
    <div class="finale__stage" data-anchor="finale-stage"></div>
  </section>
</Base>
